APP_ENV=development
DEMO_MODE=false
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL in production; SQLite fallback for local dev)
DATABASE_URL=sqlite+aiosqlite:///./reposcope.db
# In Production (Render Managed PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://reposcope_user:password@host.render.com:5432/reposcope

# JWT Authentication & Security
JWT_SECRET_KEY=reposcope_academic_evaluation_platform_jwt_secret_key_2026_cse_board_super_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Academic Evaluation Methodology Versioning
METHODOLOGY_VERSION=2.1.0
UNIVERSITY_NAME=RepoScope Academic Engineering Board
DEPARTMENT_NAME=Department of Computer Science & Engineering

# GitHub API Configuration (Optional: Increases rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
MAX_REPOSITORIES_PER_PROFILE=25
MAX_FILES_PER_REPOSITORY=80
MAX_SOURCE_FILE_SIZE=150000
MAX_TOTAL_SOURCE_SIZE=1500000
ANALYSIS_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REPOSITORIES=3
ANALYSIS_JOB_TTL_SECONDS=3600

# Optional AI-Assisted Explanation Layer
GEMINI_API_KEY=
